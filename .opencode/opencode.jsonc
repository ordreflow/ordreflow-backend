{
  "$schema": "https://opencode.ai/config.json",

  // Reuse the repository instructions for both agent tools.
  "instructions": ["../.claude/CLAUDE.md"],

  // OpenCode evaluates object rules in order; the last matching rule wins.
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/secrets/**": "deny",
      "**/*secret*": "deny",
      "**/*credential*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      ".git/**": "deny",
      ".claude/settings.local.json": "deny"
    },
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/secrets/**": "deny",
      "**/*secret*": "deny",
      "**/*credential*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      ".git/**": "deny",
      ".claude/settings.local.json": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "question": "allow",
    "todowrite": "allow",
    "task": "ask",
    "skill": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "doom_loop": "ask",
    "external_directory": {
      "*": "deny"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "git status*": "allow",
      "git diff": "allow",
      "git diff --check": "allow",
      "git diff --stat": "allow",
      "git diff --name-only": "allow",
      "git log --oneline": "allow",
      "git log --oneline -10": "allow",
      "git branch --show-current": "allow",
      "git rev-parse --show-toplevel": "allow",
      "dotnet --version": "allow",
      "dotnet --info": "allow",
      "flox list": "allow",
      "flox activate -d . -c 'dotnet --version'": "allow",
      "flox activate -d . -c 'dotnet tool restore'": "allow",
      "flox activate -d . -c 'dotnet tool restore && dotnet restore Backend/Backend.sln && dotnet build Backend/Backend.sln'": "allow",
      "dotnet run *": "ask",
      "dotnet test *": "ask",
      "dotnet ef *": "ask",
      "flox activate -d . -c 'dotnet run --project Backend/WebApi'": "ask",
      "flox install *": "ask",
      "flox search *": "ask",
      "git switch *": "ask",
      "git checkout *": "ask",
      "git branch *": "ask",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "gh *": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "git restore *": "deny",
      "git checkout -- *": "deny",
      "git checkout .": "deny",
      "git branch -D *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push --force-with-lease *": "deny",
      "git push * --force *": "deny",
      "git push * -f *": "deny",
      "flox uninstall *": "deny"
    }
  }
}
