{
  "$schema": "https://opencode.ai/config.json",

  // Reuse the repository instructions for both agent tools.
  "instructions": ["../.claude/CLAUDE.md"],

  // Fast free fallback for built-in explore/general tasks
  "model": "opencode/deepseek-v4.1-flash-free",

  "agents": {
    "plan": {
      "model": {
        "providerID": "openai",
        "model": "gpt-6-astra",
        "variant": "high"
      },
      "prompt": "You are planning work for the OrdreFlow .NET 8 backend. Break complex tasks into clear layer boundaries and delegate investigation to subagents using the task tool when helpful: use @domain-specialist for Domain/Application logic, @api-specialist for WebApi/DTOs/OpenAPI, @database-specialist for EF Core/PostgreSQL, and @architecture-reviewer to validate structural design before finalizing the plan."
    },
    "build": {
      "model": {
        "providerID": "openai",
        "model": "gpt-6.1-sol",
        "variant": "medium"
      },
      "prompt": "You are implementing changes in the OrdreFlow .NET 8 backend. Coordinate implementation across layers and delegate focused work to subagents via the task tool: @domain-specialist for Domain/Application, @api-specialist for WebApi, @database-specialist for Persistence/migrations, and @test-engineer for tests. Always invoke @reviewer (and @architecture-reviewer for major refactors) to inspect the final diff before finishing."
    },

    // Subagents
    "domain-specialist": {
      "model": {
        "providerID": "openai",
        "model": "gpt-6.1-sol",
        "variant": "medium"
      }
    },
    "database-specialist": {
      "model": {
        "providerID": "openai",
        "model": "gpt-6.1-sol",
        "variant": "medium"
      }
    },
    "api-specialist": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "test-engineer": {
      "model": "opencode/glm-5.3-flash-free"
    },
    "architecture-reviewer": {
      "model": {
        "providerID": "openai",
        "model": "gpt-6-astra",
        "variant": "high"
      }
    },
    "reviewer": {
      "model": {
        "providerID": "openai",
        "model": "gpt-6.1-sol",
        "variant": "high"
      }
    }
  },

  // OpenCode evaluates object rules in order; the last matching rule wins.
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/secrets/**": "deny",
      "**/*secret*": "deny",
      "**/*credential*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      ".git/**": "deny",
      ".claude/settings.local.json": "deny"
    },
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/secrets/**": "deny",
      "**/*secret*": "deny",
      "**/*credential*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      ".git/**": "deny",
      ".claude/settings.local.json": "deny",
      "/home/ubuntu/Projects/ordreflow-docs/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "question": "allow",
    "todowrite": "allow",
    "task": "allow",
    "skill": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "doom_loop": "ask",
    "external_directory": {
      "*": "deny",
      "/home/ubuntu/Projects/ordreflow-docs/**": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "git status*": "allow",
      "git diff": "allow",
      "git diff --check": "allow",
      "git diff --stat": "allow",
      "git diff --name-only": "allow",
      "git log --oneline": "allow",
      "git log --oneline -10": "allow",
      "git branch --show-current": "allow",
      "git rev-parse --show-toplevel": "allow",
      "dotnet --version": "allow",
      "dotnet --info": "allow",
      "flox list": "allow",
      "flox activate -d . -c 'dotnet --version'": "allow",
      "flox activate -d . -c 'dotnet tool restore'": "allow",
      "flox activate -d . -c 'dotnet tool restore && dotnet restore Backend/Backend.sln && dotnet build Backend/Backend.sln'": "allow",
      "dotnet run *": "ask",
      "dotnet test *": "ask",
      "dotnet ef *": "ask",
      "flox activate -d . -c 'dotnet run --project Backend/WebApi'": "ask",
      "flox install *": "ask",
      "flox search *": "ask",
      "git switch *": "ask",
      "git checkout *": "ask",
      "git branch *": "ask",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "gh *": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "git restore *": "deny",
      "git checkout -- *": "deny",
      "git checkout .": "deny",
      "git branch -D *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push --force-with-lease *": "deny",
      "git push * --force *": "deny",
      "git push * -f *": "deny",
      "flox uninstall *": "deny"
    }
  },
  "references": {
    "docs": {
      "path": "../ordreflow-docs",
      "description": "Project Documentation repo"
    },
    "frontend": {
      "path": "../ordreflow-frontend",
      "description": "Project Frontend repo"
    }
  }
}
