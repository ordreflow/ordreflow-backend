# Reserved for future login credential encryption; currently not read by the API
ENCRYPTION_KEY=your-encryption-key

# Database info/credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ordreflow
DB_USERNAME=ordreflow
DB_PASSWORD=change-this-local-password

# First admin login, created at startup if it does not exist. Leave empty to skip.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Administrator

# JWT login tokens. JWT_SECRET is required and must be at least 32 bytes,
# e.g. generated with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=ordreflow-api
JWT_AUDIENCE=ordreflow-frontend
JWT_EXPIRES_MINUTES=60